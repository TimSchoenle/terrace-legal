# Normalize everything Git considers text to LF on checkout; anything Git can't classify as
# text is left alone rather than guessed at.
* text=auto eol=lf

# --- Source ---
*.rs text eol=lf diff=rust
*.rs.bk -text -diff

# --- Structured data / config ---
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.dict text eol=lf

# --- Docs / prose ---
*.md text eol=lf diff=markdown
LICENSE text eol=lf
*.hbs text eol=lf

# --- Scripts ---
*.sh text eol=lf

# --- Housekeeping ---
.gitattributes text eol=lf
.gitignore text eol=lf
*.gitkeep text eol=lf

# Fuzz seeds are inputs, not prose: their exact bytes are what reproduce a finding.
fuzz/seeds/** text eol=lf
fuzz/corpus/** text eol=lf
fuzz/dictionaries/** text eol=lf

# Snapshots are compared byte for byte.
crates/*/tests/snapshots/** text eol=lf

# Machine-written artifacts: collapsed by default in GitHub diffs/stats, still diffable locally.
CHANGELOG.md linguist-generated=true
.release-please-manifest.json linguist-generated=true
Cargo.lock linguist-generated=true
